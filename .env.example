# Dominio público (lo usa Caddy para el certificado HTTPS)
DOMAIN=transbolivariana.com

# SMTP para recibir las solicitudes de cotización.
# Si SMTP_HOST o MAIL_TO están vacíos, las solicitudes solo se registran en el log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Transbolivariana Web <web@transbolivariana.ec>"
MAIL_TO=info@transbolivariana.ec
